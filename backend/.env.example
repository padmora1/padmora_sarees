PORT=5000
JWT_SECRET=replace_this_with_a_long_random_secret

# The real, canonical public domain (a .in or other secondary domain should
# redirect here at the DNS/registrar level, not here). Every transactional
# email/SMS link (order confirmation, wishlist alerts, low-stock alerts,
# pre-book alerts) is built from this one place.
SITE_URL=https://your-real-domain.example

# Required — the app's actual database (Postgres via Supabase). Get both from
# Supabase Dashboard → Project Settings → API Keys → "Legacy anon,
# service_role API keys" tab. Use service_role (not anon/publishable) —
# this is a trusted server-side backend, and service_role is what lets it
# bypass Row Level Security exactly the way better-sqlite3's full local
# access always worked. Never send this key to the frontend or a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to accept payments. Get both from the Razorpay Dashboard →
# Settings → API Keys. Use rzp_test_* keys while developing — no real money
# can move with a test key regardless of what's entered at checkout. Switch
# to rzp_live_* only once you're actually ready to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Seeded automatically on first boot with is_admin=1 — log in at /admin-login.
# Pick a real password here before ever running this against a real
# database — a fresh install with this left at the example value below
# would seed a publicly-known default password on a live store.
ADMIN_EMAIL=admin@your-real-domain.example
ADMIN_PASSWORD=replace_this_with_a_strong_unique_password

# Optional — order confirmation email. Leave unset to keep notifications
# logged-but-not-sent (visible in Admin > Settings > Order Confirmation
# Notifications). Works with any SMTP provider: Gmail app password,
# SendGrid, Mailgun, Amazon SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — order confirmation SMS via Twilio's REST API.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
